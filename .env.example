# Forms — Cloudflare Worker
#
# Submissions are always saved to the admin Inbox. FORM_RECIPIENT_EMAIL is set in wrangler.toml.
# Email also goes out only when the MailChannels key is set and the DNS records exist (see TODO.md):
#   wrangler secret put MAILCHANNELS_API_KEY
#
# Force demo responses even with a recipient:
#   wrangler secret put FORM_FORCE_DEMO   # value: true

# Google Analytics (optional — not in use)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
