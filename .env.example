# Forms — Cloudflare Worker (first-party, no Web3Forms)
#
# Until go-live secrets are set, forms run in demo mode (validate + success UI, no email sent).
#
# When PromoPower has DNS access for promopower.com.sg:
#   1. wrangler secret put FORM_RECIPIENT_EMAIL    # e.g. admin@promopower.com.sg
#   2. Add DNS TXT/SPF for MailChannels on promopower.com.sg (see TODO.md)
#   3. Set NEXT_PUBLIC_FORMS_LIVE=true in Cloudflare build env (or .env.local for local build)
#   4. npm run deploy
#
# Force demo mode even with secrets (staging):
# NEXT_PUBLIC_FORM_DEMO_MODE=true
#
# Live delivery enabled at build time (hides demo banner):
# NEXT_PUBLIC_FORMS_LIVE=true

# Google Analytics (optional — not in use)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
