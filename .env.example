# Optional: enable live form delivery via https://web3forms.com (free tier).
# Leave unset to stay in demo mode (forms validate locally and show success without emailing).
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Force demo mode even when a Web3Forms key is set (useful for staging).
# NEXT_PUBLIC_FORM_DEMO_MODE=true

# Google Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
